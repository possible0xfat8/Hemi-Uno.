# ==============================================================================
# Hemi Uno - Environment Configuration
# ==============================================================================

PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# Obtain these from your Supabase Dashboard:
# 1. Project Settings -> API -> Project URL
# 2. Project Settings -> API -> Project API keys (service_role or anon)
# ==============================================================================

# Remote Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Frontend Client-Side Supabase Keys (Exposed to browser via Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# Smart Contract & Escrow Configuration (Hemi Sepolia Testnet)
# ==============================================================================
ADMIN_WALLETS=
admin_PRIVATE_KEY=

# ==============================================================================
# Cloudflare R2 Profile Picture Storage Configuration
# ==============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hemi-profile-storage
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev
